import { useEffect, useRef, useState } from "react";
import { useNavigate, useSearchParams } from "react-router";
import {
  Button,
  Card,
  Col,
  DatePicker,
  Divider,
  Form,
  Input,
  InputNumber,
  Row,
  Select,
  Space,
  Typography,
  Tag,
} from "antd";
import {
  ArrowLeftOutlined,
  SaveOutlined,
  ThunderboltOutlined,
} from "@ant-design/icons";
import dayjs from "dayjs";
import { useKeyboardShortcut } from "../../hooks/useKeyboardShortcut";
import { useProductSearch } from "../../hooks/useProductSearch";
import { useCreateStockEntry } from "../../hooks/useStockEntryMutations";
import { formatRupiah } from "../../utility/format";
import type { Product } from "../../types";

const { Title, Text } = Typography;

interface FormValues {
  productId: number;
  supplierId: number | null;
  quantity: number;
  unitPrice: number;
  date: dayjs.Dayjs;
  note?: string;
}

export const StockEntryCreatePage = () => {
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();
  const [form] = Form.useForm<FormValues>();
  const productSearchRef = useRef<HTMLInputElement>(null);

  const preselectedId = searchParams.get("productId");
  const [searchKeyword, setSearchKeyword] = useState("");
  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null);

  const { products, isLoading: isSearching } = useProductSearch(searchKeyword);
  const createMutation = useCreateStockEntry();

  // Auto-focus ke product search saat halaman dibuka
  useEffect(() => {
    setTimeout(() => productSearchRef.current?.focus(), 100);
  }, []);

  // Jika ada productId di URL, langsung set
  useEffect(() => {
    if (preselectedId) {
      const found = products.find((p) => p.id === Number(preselectedId));
      if (found) {
        setSelectedProduct(found);
        form.setFieldsValue({
          productId: found.id,
          unitPrice: found.costPrice,
        });
      }
    }
  }, [preselectedId, products, form]);

  // ⌨️ Ctrl+Enter → submit
  useKeyboardShortcut({
    key: "Enter",
    ctrlKey: true,
    handler: () => form.submit(),
  });

  // ⌨️ Esc → kembali
  useKeyboardShortcut({
    key: "Escape",
    handler: () => navigate(-1),
  });

  const handleProductChange = (productId: number) => {
    const product = products.find((p) => p.id === productId);
    if (!product) return;
    setSelectedProduct(product);
    setSearchKeyword("");
    form.setFieldsValue({
      productId: product.id,
      unitPrice: product.costPrice,
    });
    // Fokus ke quantity setelah pilih produk
    setTimeout(() => {
      form.getFieldInstance("quantity")?.focus?.();
    }, 50);
  };

  const handleSubmit = async (values: FormValues) => {
    await createMutation.mutateAsync({
      productId: values.productId,
      supplierId: values.supplierId ?? null,
      quantity: values.quantity,
      unitPrice: values.unitPrice,
      date: values.date.format("YYYY-MM-DD"),
      note: values.note,
    });

    form.resetFields();
    setSelectedProduct(null);
    // Balik ke search produk untuk entri berikutnya
    setTimeout(() => productSearchRef.current?.focus(), 100);
  };

  const quantity = Form.useWatch("quantity", form) ?? 0;
  const unitPrice = Form.useWatch("unitPrice", form) ?? 0;
  const total = quantity * unitPrice;

  return (
    <div style={{ maxWidth: 900, margin: "0 auto" }}>
      {/* Header */}
      <div style={{ marginBottom: 16, display: "flex", alignItems: "center", gap: 12 }}>
        <Button
          icon={<ArrowLeftOutlined />}
          onClick={() => navigate(-1)}
          type="text"
        />
        <div style={{ flex: 1 }}>
          <Title level={3} style={{ margin: 0 }}>
            Input Barang Masuk
          </Title>
          <Text type="secondary">
            Tekan <Tag>Ctrl</Tag> + <Tag>Enter</Tag> untuk simpan ·{" "}
            <Tag>Esc</Tag> untuk batal
          </Text>
        </div>
      </div>

      <Card style={{ borderRadius: 12 }}>
        <Form<FormValues>
          form={form}
          layout="vertical"
          onFinish={handleSubmit}
          initialValues={{ date: dayjs() }}
          requiredMark={false}
        >
          {/* Produk */}
          <Form.Item
            name="productId"
            label="Produk"
            rules={[{ required: true, message: "Pilih produk" }]}
          >
            <Select
              showSearch
              size="large"
              placeholder="Ketik nama atau kode produk..."
              loading={isSearching}
              onSearch={setSearchKeyword}
              filterOption={false}
              onChange={handleProductChange}
              autoFocus
              ref={productSearchRef as never}
              notFoundContent={isSearching ? "Mencari..." : "Tidak ditemukan"}
              options={products.map((p) => ({
                value: p.id,
                label: `${p.name} · ${p.code} (stok: ${p.stock} ${p.unit})`,
              }))}
            />
          </Form.Item>

          {/* Info produk terpilih */}
          {selectedProduct && (
            <Card
              size="small"
              style={{
                marginBottom: 16,
                background: "#f6ffed",
                borderColor: "#b7eb8f",
              }}
            >
              <Row gutter={16}>
                <Col span={8}>
                  <Text type="secondary">Stok saat ini</Text>
                  <div>
                    <Text strong>
                      {selectedProduct.stock} {selectedProduct.unit}
                    </Text>
                  </div>
                </Col>
                <Col span={8}>
                  <Text type="secondary">Kategori</Text>
                  <div>
                    <Text strong>{selectedProduct.categoryName ?? "-"}</Text>
                  </div>
                </Col>
                <Col span={8}>
                  <Text type="secondary">Harga beli terakhir</Text>
                  <div>
                    <Text strong>{formatRupiah(selectedProduct.costPrice)}</Text>
                  </div>
                </Col>
              </Row>
            </Card>
          )}

          <Row gutter={16}>
            <Col xs={24} sm={12} md={8}>
              <Form.Item
                name="quantity"
                label="Jumlah"
                rules={[
                  { required: true, message: "Isi jumlah" },
                  {
                    type: "number",
                    min: 1,
                    message: "Minimal 1",
                  },
                ]}
              >
                <InputNumber
                  size="large"
                  style={{ width: "100%" }}
                  placeholder="0"
                  min={1}
                  addonAfter={selectedProduct?.unit ?? ""}
                />
              </Form.Item>
            </Col>

            <Col xs={24} sm={12} md={8}>
              <Form.Item name="unitPrice" label="Harga Satuan">
                <InputNumber
                  size="large"
                  style={{ width: "100%" }}
                  placeholder="0"
                  min={0}
                  formatter={(v) =>
                    `${v}`.replace(/\B(?=(\d{3})+(?!\d))/g, ".")
                  }
                  parser={(v) => Number(`${v}`.replace(/\./g, "")) as never}
                  addonBefore="Rp"
                />
              </Form.Item>
            </Col>

            <Col xs={24} sm={12} md={8}>
              <Form.Item name="date" label="Tanggal">
                <DatePicker
                  size="large"
                  style={{ width: "100%" }}
                  format="DD MMM YYYY"
                />
              </Form.Item>
            </Col>
          </Row>

          <Form.Item name="note" label="Catatan (opsional)">
            <Input.TextArea rows={2} placeholder="Contoh: pembelian rutin" />
          </Form.Item>

          <Divider style={{ margin: "12px 0 16px" }} />

          {/* Total */}
          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              padding: "12px 16px",
              background: "#fafafa",
              borderRadius: 8,
              marginBottom: 16,
            }}
          >
            <Text strong>Total</Text>
            <Text strong style={{ fontSize: 20, color: "#1677ff" }}>
              {formatRupiah(total)}
            </Text>
          </div>

          <Space>
            <Button
              type="primary"
              size="large"
              htmlType="submit"
              icon={<SaveOutlined />}
              loading={createMutation.isPending}
            >
              Simpan (Ctrl+Enter)
            </Button>
            <Button size="large" onClick={() => navigate(-1)}>
              Batal (Esc)
            </Button>
            <Text type="secondary" style={{ marginLeft: 8 }}>
              <ThunderboltOutlined /> Setelah simpan, form siap untuk entri
              berikutnya
            </Text>
          </Space>
        </Form>
      </Card>
    </div>
  );
};