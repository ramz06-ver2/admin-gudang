{
  "name": "admin-stock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:diagnostics": "vitest run tests/diagnostics",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/smoke",
    "verify": "npm run typecheck && npm run test:run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ant-design/plots": "^2.3.3",
    "@refinedev/antd": "^5.45.2",
    "@refinedev/core": "^4.57.8",
    "@refinedev/kbar": "^1.3.16",
    "@refinedev/react-router-v6": "^4.5.6",
    "@refinedev/supabase": "^5.9.4",
    "@supabase/supabase-js": "^2.45.6",
    "@tanstack/react-query": "4.44.0",
    "antd": "^5.21.6",
    "dayjs": "^1.11.13",
    "dotenv": "^18.0.7",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "@tanstack/react-query": "4.44.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
